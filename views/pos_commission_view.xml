<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista Lista -->
    <record id="view_pos_commission_list" model="ir.ui.view">
        <field name="name">pos.commission.list</field>
        <field name="model">pos.commission</field>
        <field name="arch" type="xml">
            <list string="Comisiones"
                  default_group_by="x_studio_date:month"
                  create="0"
                  delete="0">
                <field name="x_studio_user_id"/>
                <field name="x_studio_product_id"/>
                <field name="x_studio_date"/>
                <field name="x_studio_unit_price" optional="show"/>
                <field name="x_studio_quantity" optional="show"/>
                <field name="x_studio_percentage" optional="show"/>
                <field name="x_studio_commission_amount" sum="Total Comisión"/>
                <field name="x_studio_is_paid" widget="boolean_toggle"/>
                <field name="x_studio_state" widget="badge"
                       decoration-success="x_studio_state == 'paid'"
                       decoration-info="x_studio_state == 'draft'"/>
                <field name="x_studio_order_id" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Vista Formulario (TODOS los campos readonly, sin crear/editar/borrar) -->
    <record id="view_pos_commission_form" model="ir.ui.view">
        <field name="name">pos.commission.form</field>
        <field name="model">pos.commission</field>
        <field name="arch" type="xml">
            <form string="Comisión" create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_x_studio_mark_as_paid"
                                type="object"
                                string="Marcar como Pagada"
                                class="oe_stat_button"
                                icon="fa-check"
                                invisible="x_studio_is_paid"/>
                    </div>
                    <group>
                        <group string="Información General">
                            <field name="x_studio_user_id" readonly="1"/>
                            <field name="x_studio_date" readonly="1"/>
                            <field name="x_studio_order_id" readonly="1"/>
                            <field name="x_studio_product_id" readonly="1"/>
                        </group>
                        <group string="Detalles de Comisión">
                            <field name="x_studio_unit_price" readonly="1"/>
                            <field name="x_studio_quantity" readonly="1"/>
                            <field name="x_studio_percentage" readonly="1"/>
                            <field name="x_studio_commission_amount"
                                   class="oe_inline"
                                   readonly="1"
                                   style="font-weight: bold; font-size: 1.2em;"/>
                            <field name="x_studio_is_paid"
                                   widget="boolean_toggle"
                                   readonly="1"
                                   string="Pagado"/>
                            <field name="x_studio_state"
                                   widget="badge"
                                   readonly="1"
                                   decoration-success="x_studio_state == 'paid'"
                                   decoration-info="x_studio_state == 'draft'"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista Búsqueda -->
    <record id="view_pos_commission_search" model="ir.ui.view">
        <field name="name">pos.commission.search</field>
        <field name="model">pos.commission</field>
        <field name="arch" type="xml">
            <search string="Comisiones">
                <field name="x_studio_user_id"/>
                <field name="x_studio_product_id"/>
                <field name="x_studio_order_id"/>
                <filter name="filter_paid" string="Pagadas"
                        domain="[('x_studio_is_paid', '=', True)]"/>
                <filter name="filter_unpaid" string="No Pagadas"
                        domain="[('x_studio_is_paid', '=', False)]"/>
                <separator/>
                <filter name="group_user" string="Usuario"
                        context="{'group_by': 'x_studio_user_id'}"/>
                <filter name="group_product" string="Producto"
                        context="{'group_by': 'x_studio_product_id'}"/>
                <filter name="group_month" string="Mes"
                        context="{'group_by': 'x_studio_date:month'}"/>
                <filter name="group_year" string="Año"
                        context="{'group_by': 'x_studio_date:year'}"/>
            </search>
        </field>
    </record>

    <!-- Vista Pivot -->
    <record id="view_pos_commission_pivot" model="ir.ui.view">
        <field name="name">pos.commission.pivot</field>
        <field name="model">pos.commission</field>
        <field name="arch" type="xml">
            <pivot string="Análisis de Comisiones">
                <field name="x_studio_user_id" type="row"/>
                <field name="x_studio_date" type="col"/>
                <field name="x_studio_commission_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Vista Gráfico -->
    <record id="view_pos_commission_graph" model="ir.ui.view">
        <field name="name">pos.commission.graph</field>
        <field name="model">pos.commission</field>
        <field name="arch" type="xml">
            <graph string="Comisiones por Usuario" type="bar">
                <field name="x_studio_user_id"/>
                <field name="x_studio_commission_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Acción de Ventana -->
    <record id="action_pos_commission" model="ir.actions.act_window">
        <field name="name">Comisiones</field>
        <field name="res_model">pos.commission</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="context">{'search_default_group_month': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay comisiones registradas.
            </p>
            <p>
                Las comisiones se generan automáticamente al validar órdenes
                del Punto de Venta con productos configurados para generar comisión.
            </p>
        </field>
    </record>

</odoo>